        <mxCell id="ci_2" value="&lt;b&gt;2. Shift-Left SAST &amp;amp; IaC&lt;/b&gt;&lt;br&gt;• Gitleaks (.gitleaks.toml)&lt;br&gt;• Semgrep (semgrep-rules.yaml)&lt;br&gt;• TFLint (.tflint.hcl) + Trivy IaC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;" vertex="1" parent="1">
