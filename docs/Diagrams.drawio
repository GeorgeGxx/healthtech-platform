        </mxCell>
        <mxCell id="az_acr" value="&lt;b&gt;Azure Container Registry (ACR)&lt;/b&gt;&lt;br&gt;AcrPull Role + Cosign Signed Images&lt;br&gt;OCI Helm Chart (k8s/helm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#4C1D95;fontSize=11;" vertex="1" parent="1">
