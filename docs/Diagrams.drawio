        </mxCell>
        <mxCell id="az_data" value="&lt;b&gt;Azure Managed Data &amp; Messaging&lt;/b&gt;&lt;br&gt;• Azure Database for PostgreSQL Flexible Server&lt;br&gt;• Azure Cache for Redis (TLS 1.2)&lt;br&gt;• Azure Event Hubs (Kafka Protocol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontColor=#78350F;fontSize=11;" vertex="1" parent="1">
