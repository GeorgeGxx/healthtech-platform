        </mxCell>
        <mxCell id="ci_3" value="&lt;b&gt;3. Image, SBOM &amp;amp; Policy&lt;/b&gt;&lt;br&gt;• BuildKit OCI + CycloneDX SBOM&lt;br&gt;• Trivy Container Scan (HIGH/CRIT)&lt;br&gt;• OPA Conftest + Cosign v3.1.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontColor=#4C1D95;fontSize=11;" vertex="1" parent="1">
