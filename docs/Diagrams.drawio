        </mxCell>
        <mxCell id="az_aks" value="&lt;b&gt;Azure Kubernetes Service (AKS)&lt;/b&gt;&lt;br&gt;dev: healthtech-azure-dev-aks&lt;br&gt;staging: healthtech-azure-staging-aks&lt;br&gt;prod: Dual Dataplane (DP1 + DP2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontColor=#064E3B;fontSize=11;" vertex="1" parent="1">
