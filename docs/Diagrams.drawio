        <mxCell id="ci_1" value="&lt;b&gt;1. Build &amp;amp; Unit Tests&lt;/b&gt;&lt;br&gt;Node 24 (NestJS / Angular)&lt;br&gt;Optional SonarCloud Quality Gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontColor=#1E3A8A;fontSize=11;" vertex="1" parent="1">
