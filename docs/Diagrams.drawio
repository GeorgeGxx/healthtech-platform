        <mxCell id="t3" value="&lt;b style='font-size:22px;color:#1E293B;'&gt;AZURE DEVOPS CI/CD &amp;amp; DEVSECOPS PIPELINES&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px;color:#64748B;'&gt;azure-devops/pipelines/ (8 Services + infra.yml) • Centralized devsecops/ Hub&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
