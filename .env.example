# Platform: Minikube (Local), Docker Compose, Azure (AKS)
# Copy this file to .env and replace every value before non-local use.
POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
DEV_AUTH_ENABLED=true
KAFKA_BROKER=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379
PHI_ENCRYPTION_KEY=replace-with-a-32-byte-hex-or-base64-secret-in-production
PRESCRIPTION_HMAC_SECRET=replace-with-a-strong-hmac-secret-in-production
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://kong:8000
OTEL_EXPORTER_OTLP_ENDPOINT=http://elastic-agent:4318
