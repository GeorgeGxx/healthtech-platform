{
  "info": {
    "_postman_id": "healthtech-platform-collection-2026",
    "name": "HealthTech Platform — Microservices & Kong Gateway 3.9.4 Contract Suite",
    "description": "End-to-end API contract verification for all 7 NestJS 12 microservices via Kong Gateway v3.9.4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1. Health & Readiness Probes",
      "item": [
        {
          "name": "Appointment Service Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Kong correlation ID header present', () => pm.response.to.have.header('X-Correlation-ID'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/appointments/health", "host": ["{{baseUrl}}"], "path": ["api", "appointments", "health"] }
          }
        },
        {
          "name": "Patient Service Health",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
